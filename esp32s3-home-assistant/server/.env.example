# Speech-to-Phrase is the only command recognizer. Keep the real long-lived
# Home Assistant token in the ignored .env file, never in this example.
SPEECH_TO_PHRASE_BIND_ADDRESS=127.0.0.1
SPEECH_TO_PHRASE_PORT=11300
SPEECH_DIAGNOSTICS_BIND_ADDRESS=127.0.0.1
SPEECH_DIAGNOSTICS_PORT=11400
SPEECH_DIAGNOSTICS_MAX_RECORDS=200
SPEECH_DIAGNOSTICS_MAX_BYTES=268435456
SPEECH_DIAGNOSTICS_SERVE_AUDIO=1
SPEECH_TO_PHRASE_HASS_WEBSOCKET_URI=ws://host.docker.internal:8123/api/websocket
SPEECH_TO_PHRASE_HASS_TOKEN=

PIPER_BIND_ADDRESS=127.0.0.1
PIPER_PORT=11200
PIPER_VOICE=en_US-lessac-medium
