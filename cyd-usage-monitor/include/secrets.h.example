#ifndef SECRETS_H
#define SECRETS_H

// Use Wokwi-GUEST with an empty password in the simulator.
#define WIFI_SSID "Wokwi-GUEST"
#define WIFI_PASS ""

// Prefer the private HTTPS reverse-proxy endpoint. The ESP32 never holds
// provider credentials.
#define TELEMETRY_SERVER_URL "https://monitor.example.invalid/api/v1/cyd-status"

// PEM-encoded root/intermediate CA that validates the HTTPS endpoint.
// Keep this empty only while preparing the configuration; HTTPS requests fail
// closed until a CA is supplied.
#define TELEMETRY_CA_CERT ""

// Plain HTTP exposes the reusable CYD token. Enable this only for an isolated,
// trusted LAN when TLS is genuinely unavailable.
#define TELEMETRY_ALLOW_INSECURE_HTTP 0

// Required: set this to the same CYD_API_TOKEN configured on the host.
#define TELEMETRY_API_TOKEN ""

#endif
