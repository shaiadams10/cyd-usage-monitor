#ifndef SECRETS_H
#define SECRETS_H

// Use Wokwi-GUEST with an empty password in the simulator.
#define WIFI_SSID "Wokwi-GUEST"
#define WIFI_PASS ""

// Use the monitor server's private RFC1918 LAN address. Firmware rejects
// public hosts so the Bearer token cannot accidentally be sent to the
// Internet. Never commit the real address.
#define TELEMETRY_SERVER_URL "http://LAN_SERVER_IP:8001/api/v1/cyd-status"

// Required: set this to the same CYD_API_TOKEN configured on the host.
#define TELEMETRY_API_TOKEN ""

#endif
