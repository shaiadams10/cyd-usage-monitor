# Copy this file to .env on the monitor host. Never commit the real file.
# Set a unique dashboard password with at least 16 characters before exposing
# the service. If blank, the app creates a random password in the private data
# directory on first start.
MONITOR_ADMIN_PASSWORD=
# Required for the physical display; use at least 24 random characters and
# configure the same value in include/secrets.h.
CYD_API_TOKEN=
# Background refresh interval for CLI profiles that are not shown on the CYD.
CYD_MONITOR_POLL_SECONDS=90
# Faster refresh for the account currently selected for the display (10–86400).
CYD_MONITOR_ACTIVE_POLL_SECONDS=30
# CLI captures that may run at the same time (1–16). Each one starts a full
# provider CLI process, so keep this modest on small hosts.
CYD_MONITOR_MAX_PARALLEL_COLLECTIONS=3
# Require consecutive failed CLI collections before sending an outage alert.
# A value of 3 suppresses short provider/terminal glitches while still
# retaining each failed capture in the protected incident history.
CYD_MONITOR_ALERT_FAILURE_THRESHOLD=3
# Device traffic bypasses Cloudflare and is published only on this host-side
# address/port. Keep the safe loopback default here; set the monitor server's
# real private-LAN address only in the ignored .env.
CYD_LAN_BIND_ADDRESS=127.0.0.1
CYD_LAN_PORT=8001

# Optional operator-only deployment inventory. Use the ignored .env for real
# hostnames and filesystem paths; Compose does not consume these values.
CYD_MONITOR_DEPLOY_HOST=ssh.example.com
CYD_MONITOR_DEPLOY_DIR=/srv/cyd-usage-monitor

# Cloudflare setup-only credentials. The API token is used by an operator or
# provisioning tool and must never be passed to a runtime container.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Remotely managed Cloudflare Tunnel. The tunnel token is the only Cloudflare
# value consumed by Docker Compose.
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=replace-with-remotely-managed-tunnel-token
CLOUDFLARE_DASHBOARD_HOSTNAME=dashboard.example.com

# Dashboard identity allow-list. Device requests stay on the private LAN and
# use the separate CYD_API_TOKEN above, not Cloudflare Access credentials.
CLOUDFLARE_ACCESS_ALLOWED_EMAIL=operator@example.com

# Host paths mounted by Docker. Keep these directories private and ignored.
CYD_MONITOR_HOST_DATA_DIR=./data
CYD_MONITOR_HOST_PROFILE_DIR=./profiles
# Paths to the host-installed CLI executables and their Node runtime.
AGY_HOST_PATH=/absolute/path/to/agy
CODEX_HOST_DIR=/absolute/path/to/codex-install
NODE_BIN_HOST_DIR=/absolute/path/to/node-bin

# WAHA alert delivery.  The collector sends one alert when a profile first
# fails and one recovery notice after its next successful collection.
WAHA_URL=http://127.0.0.1:3000
WAHA_API_KEY=
# Name of the connected WAHA session shown in the WAHA dashboard, for example
# "production". It is not always named "default".
WAHA_SESSION=your-connected-waha-session
WAHA_ALERT_CHAT_ID=your-group-id@g.us
# IANA timezone used for provider CLI quota resets, container system time, and WhatsApp timestamps.
CYD_MONITOR_TIMEZONE=UTC

# Independent fallback for a WAHA delivery failure. Use a dedicated
# transactional SMTP credential or app password; only TLS modes are accepted.
# These values remain in the private collector environment and are never
# returned to the dashboard. Multiple recipients may be comma-separated.
CYD_MONITOR_SMTP_HOST=smtp.example.com
CYD_MONITOR_SMTP_PORT=587
CYD_MONITOR_SMTP_SECURITY=starttls
CYD_MONITOR_SMTP_USERNAME=
CYD_MONITOR_SMTP_PASSWORD=
CYD_MONITOR_SMTP_FROM=cyd-monitor@example.com
CYD_MONITOR_ALERT_EMAIL_TO=operator@example.com
